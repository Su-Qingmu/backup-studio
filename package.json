{
  "name": "backup-studio",
  "productName": "Backup Studio",
  "version": "0.1.0",
  "private": true,
  "description": "高性能本地目录备份工具：哈希去重、改名同步、多线程复制、断点续传、拔盘恢复",
  "main": "dist-electron/electron/main.js",
  "author": "Su-Qi",
  "license": "MIT",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:engine": "tsx test/engine.test.ts",
    "test:aut": "tsx test/auto-sync.test.ts",
    "test:gate": "tsx test/write-gate.test.ts",
    "test:permit": "tsx test/write-permit.test.ts",
    "test:recycle": "tsx test/recycle.test.ts",
    "test:transaction": "node --import tsx --test test/transaction-recovery.test.ts",
    "test:dup": "tsx test/dup.test.ts",
    "test:reveal": "tsx test/reveal-authority.test.ts",
    "test:recycle-crash": "tsx test/recycle-crash.test.ts",
    "test": "npm run test:engine && npm run test:aut && npm run test:gate && npm run test:permit && npm run test:recycle && npm run test:transaction && npm run test:dup && npm run test:reveal && npm run test:recycle-crash",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:linux": "npm run build && electron-builder --linux --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.sqm.backupstudio",
    "productName": "Backup Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Backup Studio"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Su-Qi"
    }
  }
}
